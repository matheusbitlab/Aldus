{
  "name": "aldus-reader",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:apk": "eas build --platform android --profile preview",
    "build:apk:local": "node scripts/build-apk-local.mjs",
    "build": "expo export --platform web && node scripts/copy-books-to-dist.mjs",
    "typecheck": "tsc --noEmit",
    "covers:generate": "node scripts/generate-book-covers.mjs",
    "legal:notices": "node scripts/generate-third-party-notices.cjs",
    "legal:notices:check": "node scripts/generate-third-party-notices.cjs --check",
    "test:legal": "node scripts/test-legal.cjs",
    "test:legal:browser": "node scripts/test-legal-browser.cjs",
    "test:import": "node scripts/test-book-import.cjs && node scripts/test-download-import.cjs",
    "test:ocr": "node scripts/test-pdf-ocr.cjs",
    "test:drive": "node scripts/test-google-drive.cjs && node scripts/test-drive-download.cjs",
    "test:source-catalog": "node scripts/test-source-catalog.cjs && node scripts/test-source-library-actions.cjs",
    "test:source-library:browser": "node scripts/test-source-library-browser.cjs",
    "audit:supabase:public": "node scripts/audit-supabase-public.cjs",
    "export:web": "expo export --platform web && node scripts/copy-books-to-dist.mjs",
    "test:library:account": "node scripts/test-library-account.cjs",
    "test:library:rls": "node scripts/test-library-rls.cjs",
    "build:apk:archive": "node scripts/archive-commit-apk.mjs",
    "test:library:sync": "node scripts/test-library-sync.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native/js-polyfills": "0.76.9",
    "@supabase/supabase-js": "^2.117.2",
    "cheerio": "^1.2.0",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.12",
    "expo-brightness": "~57.0.2",
    "expo-constants": "~57.0.12",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-sensors": "~57.0.3",
    "expo-sqlite": "~57.0.3",
    "fast-xml-parser": "^5.11.0",
    "jszip": "^3.10.1",
    "nativewind": "4.1.23",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.1.22",
    "react-native-reanimated": "4.5.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@types/react": "~19.2.0",
    "metro": "^0.84.4",
    "metro-cache": "^0.81.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native": "$react-native",
    "react-native-reanimated": "$react-native-reanimated"
  }
}
